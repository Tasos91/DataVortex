 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Consumer lag (το πιο σημαντικό)",
   "description": "Μηνύματα στο Kafka που δεν έχουν αποθηκευτεί ακόμα. Αν ανεβαίνει σταθερά, η αποθήκευση δεν προλαβαίνει.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(datavortex_kafka_consumer_lag)",
     "legendFormat": "σύνολο"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "datavortex_kafka_consumer_lag_records",
     "legendFormat": "{{topic}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
