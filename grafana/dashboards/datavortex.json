     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(datavortex_db_rows_total{result=\"written\"}[1m]))",
     "legendFormat": "γράφτηκαν στη βάση"
    }
   ]
  },
  {
