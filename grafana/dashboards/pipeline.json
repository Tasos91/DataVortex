{
 "uid": "datavortex-pipeline",
 "title": "DataVortex — όλος ο σωλήνας",
 "tags": [
  "datavortex"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Consumer lag — προλαβαίνει η αποθήκευση;",
   "description": "Μηνύματα στο Kafka που δεν έχουν αποθηκευτεί. Αν ανεβαίνει σταθερά, το consume δεν προλαβαίνει το ingest.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 16,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(datavortex_kafka_consumer_lag)",
     "legendFormat": "σύνολο"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "datavortex_kafka_consumer_lag_records",
     "legendFormat": "{{topic}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Υγεία υπηρεσιών",
   "description": "1 = η υπηρεσία απαντά στο scrape.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "UP",
         "color": "green",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"datavortex\"}",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Ρυθμός στα τρία στάδια (rec/s)",
   "description": "Οι τρεις καμπύλες πρέπει να ακολουθούν η μία την άλλη. Απόκλιση = συμφόρηση στο ενδιάμεσο στάδιο.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(datavortex_ingest_records_total{result=\"accepted\"}[1m]))",
     "legendFormat": "1. στο Kafka"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(datavortex_consume_records_total{result=\"ok\"}[1m]))",
     "legendFormat": "2. διαβάστηκαν"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(datavortex_db_rows_total{result=\"written\"}[1m]))",
     "legendFormat": "3. γράφτηκαν"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Γραμμές βάσης ανά αποτέλεσμα (rec/s)",
   "description": "duplicate = η idempotency δουλεύει (αναμενόμενο σε rebalance). rejected = γραμμές που απέρριψε η βάση.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (result) (rate(datavortex_db_rows_total[1m]))",
     "legendFormat": "{{result}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Χρόνος εγγραφής στη βάση ανά batch",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
