   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service,cache) (rate(cache_gets_total{result=\"hit\"}[5m])) / clamp_min(sum by (service,cache) (rate(cache_gets_total[5m])), 0.001)",
     "legendFormat": "{{service}} · {{cache}}"
    }
   ]
